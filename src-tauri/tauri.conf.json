{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebLander",
  "mainBinaryName": "weblander",
  "version": "1.0.0",
  "identifier": "io.github.crunchy000.WebLander",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "npm run assemble:desktop",
    "beforeBuildCommand": "npm run assemble:desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "WebLander",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Game",
    "publisher": "Matt Churcher",
    "homepage": "https://crunchy000.github.io/WebLander/",
    "license": "MIT",
    "shortDescription": "Fly a drone over an endless landscape.",
    "longDescription": "A tribute to Lander, the flat-shaded 3D game David Braben wrote for the Acorn Archimedes in 1987. Fly the lander over procedurally generated terrain, through day and night, weather and biomes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
